{
  "name": "ml-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Learn machine learning from first principles in the browser: lessons, formulas, quizzes and coding exercises with tests, all running locally.",
  "scripts": {
    "predev": "node scripts/copy-pyodide.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pyodide.mjs",
    "build": "node scripts/lint-content.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "offline": "node scripts/offline.mjs",
    "check": "node scripts/check-exercises.mjs",
    "e2e": "node scripts/e2e.mjs",
    "package": "node scripts/package-site.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/source-code-pro": "5.3.1",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource-variable/source-serif-4": "5.2.9",
    "@lezer/highlight": "1.2.5",
    "katex": "0.16.22",
    "marked": "15.0.12",
    "pyodide": "0.29.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.2",
    "playwright": "1.63.0",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
